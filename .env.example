# ==============================================================================
# PROJECT SAATHI - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# IMPORTANT: Never commit actual API keys, credentials, or production secrets!
# ==============================================================================

# Runtime Environment
NODE_ENV=development
SAATHI_DEMO_MODE=true

# API & Gateway Ports
PORT=5000
VITE_API_BASE_URL=http://localhost:5000/api

# Security & Session Authentication
JWT_SECRET=replace_with_a_secure_random_64_character_string_for_production
JWT_EXPIRES_IN=8h
DATABASE_ENCRYPTION_KEY=replace_with_secure_aes256_passphrase_for_sqlcipher

# Offline Database Persistence
SQLITE_DB_PATH=./data/saathi_local.db

# SMS Gateway Integration (Options: mock, twilio, gupshup, fast2sms)
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=AC_dummy_placeholder_sid
TWILIO_AUTH_TOKEN=dummy_placeholder_auth_token
TWILIO_FROM_PHONE=+919876543210

# Firebase Cloud Messaging & Firestore (Optional Cloud Integration)
FIREBASE_PROJECT_ID=project-saathi-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@project-saathi-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC6...\n-----END PRIVATE KEY-----\n"

# District Analytics Anonymization Settings
SMALL_CELL_SUPPRESSION_THRESHOLD=5
MAX_MAP_ZOOM_LEVEL=12
