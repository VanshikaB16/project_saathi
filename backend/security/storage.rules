rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return request.auth.token.role;
    }

    // Medical images must never be publicly readable or writable!
    match /patient_images/{patientId}/{imageId} {
      allow read: if isAuthenticated() && (getUserRole() == 'ASHA_WORKER' || getUserRole() == 'CLINICIAN');
      allow write: if isAuthenticated() && getUserRole() == 'ASHA_WORKER'
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isAuthenticated() && getUserRole() == 'SYSTEM_ADMIN';
    }

    // Lab reports & Microscope smears
    match /lab_documents/{patientId}/{docId} {
      allow read: if isAuthenticated() && (getUserRole() == 'ASHA_WORKER' || getUserRole() == 'CLINICIAN');
      allow write: if isAuthenticated() && (getUserRole() == 'ASHA_WORKER' || getUserRole() == 'CLINICIAN')
                   && request.resource.size < 15 * 1024 * 1024;
    }

    // Audio preferred names
    match /audio_names/{patientId}/{audioId} {
      allow read: if isAuthenticated() && (getUserRole() == 'ASHA_WORKER' || getUserRole() == 'CLINICIAN');
      allow write: if isAuthenticated() && getUserRole() == 'ASHA_WORKER'
                   && request.resource.size < 2 * 1024 * 1024;
    }
  }
}
